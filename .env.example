# Backend reads this file from the repository root. Copy to .env for overrides.
# Comma-separated exact browser origins; no wildcard needed for local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Safe offline default. Live requests require deliberate Groq selection and a submission.
LLM_PROVIDER=fake
# Leave blank for fake mode. Put a real key only in an ignored backend environment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=3072
GROQ_TIMEOUT_SECONDS=30
# Never put credentials in VITE_* variables. No paid fallback or automatic retries.
0.# Retrieval is local and independent of LLM_PROVIDER. Semantic falls back visibly.
RETRIEVAL_METHOD=tfidf
RETRIEVAL_TOP_K=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional local model directory; default: .cache/models/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=.cache/models/all-MiniLM-L6-v2
